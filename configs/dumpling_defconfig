# Kernel configuration of the OnePlus 5T image. CONFIG_XNU_<NAME> becomes XNU_<NAME> for the
# kernel build.
#
# B4/P4: the UFS warm-link probe reads the SHNGROOT OS/SystemOS windows from the
# userdata partition, and NativeRamBlock supplies the packed scratch Data seed.
# mockfs remains the fallback root; Adreno, PAN and MobileDisplay stay off.

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
# The BCM2837 panic-log address (0x3c0fc000) is not an MSM8998 region; use
# /pram + /chosen/embedded-panic-log-size from the ADT instead.
CONFIG_XNU_DT_PANIC_REGION=y
# B3 has no registered img4if/amfi provider at trust_cache_init time yet.
# Re-enable when the AppleImage4/AMFI prelink initialization order is qualified.
# CONFIG_XNU_TRUST_CACHE_RUNTIME is not set
CONFIG_XNU_SOURCE_MOCKFS=y

# B3 has no prelinked corecrypto OSKext startup before kmem_crypto_init();
# use the source bootstrap registered at STARTUP(EARLY_BOOT, FIRST).
CONFIG_XNU_CRYPTO_BOOTSTRAP="source"

# Not yet:
# The legacy display kit is for IOMobileFramebuffer/userland (B7); the B3 kernel console
# uses boot_args->Video from DarwinBoot and needs no extra kit.
# CONFIG_XNU_NATIVE_LEGACY_DISPLAY is not set
# CONFIG_XNU_BOOT_PROGRESS is not set
# P4: the packed Data seed is published by NativeRamBlock; the
# OWNER_DATA_MOUNT path mounts it at /private/var.  Source crypto is kept, so
# the NativeRamBlock guard is satisfied through OWNER_DATA_MOUNT=1 rather than
# the NativeAES/prelinked closure.
CONFIG_XNU_NATIVE_RAM_BLOCK=y
# CONFIG_XNU_NATIVE_AES is not set
# CONFIG_XNU_NATIVE_UFS is not set
# Warm-link UFS probe: read the 5T userdata GPT and the SHNGROOT OS/SystemOS
# windows.  This is the Probe path, not the full NativeUfs runtime.
CONFIG_XNU_NATIVE_UFS_PROBE=y
# Mount the packed Data seed at /private/var; the workflow sets
# XNU_OWNER_DATA_VOLATILE=1 and the skeleton's volume UUID.
CONFIG_XNU_OWNER_DATA_MOUNT=y
# CONFIG_XNU_NATIVE_ADRENO is not set
CONFIG_XNU_SHENG_PMGR=y
# CONFIG_XNU_NATIVE_PAN is not set
# CONFIG_XNU_NATIVE_MOBILE_DISPLAY is not set
# CONFIG_XNU_NATIVE_VIRTIO_BLOCK is not set
# CONFIG_XNU_VERIFIED_ROOT_PROBE is not set
